#HERE
MA_MC_speech <-
speech_matched %>%
#mutate(Q409 = recode(Q409, "Laurel" = "Laurel Hearers", "Yanny" = "Yanny Hearers"))%>%
mutate(stim_type = recode(stim_type, "illusion" = "Illusion", "control" = "Control")) %>%
mutate(group = factor(group, fct_reorder(c("Matched Controls", "Musical Anhedonics")))) %>%
mutate(group = recode(group, "Musical Anhedonics" = "Individuals with\nMusical Anhedonia")) %>%
ggplot(aes(x=pre_post, y=value, color=stim_type)) +
#ggdist::geom_dotsinterval() +
stat_summary(fun.data = 'mean_se', geom = 'errorbar', width = 0.05, alpha=1,linewidth=1) +
stat_summary(fun.data = 'mean_se', geom = 'pointrange', alpha=1, size=0.3) +
theme_bw()+
#geom_jitter(width=0.4,height=0.4,alpha=0.1) +
#geom_line(alpha=0.05, color="black")+
#geom_point()+
theme(legend.position = "none")+
ylab("Musicality Rating") +
xlab("") +
theme(
axis.title.y = element_text(family="Arial",size=30),
axis.text.x = element_text(family="Arial", size=20),
axis.text.y = element_text(family="Arial",size=18),
strip.text = element_text(family="Arial",size=24,color='black')
) +
#coord_cartesian(ylim=c(2.25,4.75))+
facet_grid(~group) +
scale_x_discrete(labels = c("Pre Repetition", "Post Repetition")) +
#scale_y_continuous(breaks=c(2.5,3.0, 3.5, 4, 4.5)) +
ggrepel::geom_label_repel(data=labels, aes(label=stim_type),min.segment.length = Inf, size=8) +
scale_color_manual(values=c("#0072B2", "#D55E00" )) +
scale_fill_manual(values=c("#0072B2","#D55E00"))
