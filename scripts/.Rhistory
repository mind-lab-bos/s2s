age_master$clip_rename = NA
age_master <- merge(dataclean_post, age_data, by.x="Participant.Public.ID", by.y="ID")
age_master <- merge(dataclean_post, age_data, by.x="Participant.Public.ID", by.y="ID")
age_master$Age.Group <- as.factor(age_master$Age.Group)
age_master$Age.Group[age_master$Age.Group==""] <- NA
contrasts(age_master$Age.Group)
age_master$clip_rename = NA
age_master$clip_rename <- ifelse(age_master$outcome_type=="Original", age_master$clip, paste(age_master$clip,"_Man",sep = ""))
age_master_stim <- merge(age_master, stim_data, by.x="clip_rename",by.y="clip")
#linear
age_master_stim$liking_scaled <- scale(age_master_stim$rating_like)
age_master_stim$manipulation_scaled <- scale(age_master_stim$manipulation)
#quadratic
quadmodel <- lmer(liking_scaled ~  poly(manipulation_scaled,2,raw=TRUE)*outcome_type + scale(entropy_name)*Age.Group + (poly(manipulation_scaled,2,raw=TRUE)outcome_type + scale(entropy_name)|Participant.Public.ID),control=lmerControl(optimizer="bobyqa"), data=age_master_stim)
#kids only
kid_entropy <- age_master_stim %>%
subset(Age.Group=="Child")
linmodel_kids <- lmer(liking_scaled ~  manipulation_scaled*outcome_type + scale(entropy_name) + scale(seq_length_name) + scale(unique_pitches_name) + (manipulation_scaled:outcome_type + outcome_type + scale(entropy_name) + scale(seq_length_name) + scale(unique_pitches_name)|Participant.Public.ID),control=lmerControl(optimizer="bobyqa"), data=kid_entropy)
kid_entropy_plot <-
kid_entropy %>%
ggplot(aes(x=scale(entropy_name), y=(rating_like)))+
#geom_point(alpha=0.5) +
stat_summary(fun.data = 'mean_se', geom = 'errorbar', width = 0.2, alpha=0.7) +
stat_summary(fun.data = 'mean_se', geom = 'pointrange', alpha=0.7) +
theme_classic() +
#stat_smooth(method = "gam", formula = y ~ s(x, bs = "cs")) +
xlab("BP Melody Interval Entropy (Scaled)")+
ylab("Liking Rating") +
theme( axis.title.x = element_text(family="Arial", size=22),
axis.title.y = element_text(family="Arial",size=22),
axis.text.x = element_text(family="Arial", size=20),
axis.text.y = element_text(family="Arial",size=20),
strip.text.x = element_text(family="Arial",size=20)) +
geom_smooth(method="lm")
ggsave(file='../figures/ICMPC25/kid_entropy_plot.png', kid_entropy_plot, dpi=1000)
